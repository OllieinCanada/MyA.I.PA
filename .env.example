DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myaipa?schema=public"
NODE_ENV=development
PORT=8787
DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
OWNER_SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Signed inbound preference webhook and the private consent check used by phone assistants.
TWILIO_INBOUND_WEBHOOK_URL=http://localhost:8787/api/webhooks/sms
SMS_SUPPRESSION_CHECK_URL=http://localhost:8787/api/integrations/sms/suppression/check
SMS_SUPPRESSION_API_KEY=

REACT_APP_GOOGLE_MAPS_API_KEY=
# Local development can leave this blank and use the CRA proxy to PORT=8787.
# Production should point this at your backend API if using Stripe Checkout.
REACT_APP_API_BASE_URL=
REACT_APP_CHECKOUT_API_BASE_URL=
REACT_APP_MAKE_SIGNUP_WEBHOOK_URL=
REACT_APP_MAKE_SIGNUP_WEBHOOK_API_KEY=
REACT_APP_TURNSTILE_SITE_KEY=
OPENAI_API_KEY=YOUR_KEY
MAKE_SIGNUP_WEBHOOK_URL=
MAKE_SIGNUP_WEBHOOK_API_KEY=
INTEGRATION_API_KEY=
# Optional explicit override. Production otherwise derives a one-way, webhook-only
# credential from VAPI_API_KEY; never reuse INTEGRATION_API_KEY here.
VAPI_WEBHOOK_SECRET=

# X job finder. Requires an X API bearer token with recent search access.
X_API_BASE_URL=https://api.x.com
X_BEARER_TOKEN=

# Stripe Checkout. Create a recurring Price in Stripe and paste its price_... ID here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=14
TRIAL_HALFWAY_REMINDER_DAYS=7
TRIAL_REMINDER_CHECK_INTERVAL_MS=3600000
TRIAL_REMINDER_DISABLE=false
STRIPE_ALLOW_PROMOTION_CODES=false
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_APP_URL=http://localhost:3000
STRIPE_SUCCESS_URL=http://localhost:3000/#/signup?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/#/signup?payment=cancelled

TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
SIGNUP_REQUIRE_MANUAL_APPROVAL=false
SIGNUP_REQUIRE_VERIFICATION=false
SIGNUP_VERIFICATION_TTL_MS=86400000
SIGNUP_VERIFICATION_BASE_URL=http://localhost:8787
EMAIL_VERIFICATION_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="My AI PA <hello@myaipa.com>"

# Optional owner/staff calendar connections. Customers never need OAuth.
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_OAUTH_STATE_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8787/api/calendar/oauth/google/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:8787/api/calendar/oauth/microsoft/callback
SIGNUP_IP_WINDOW_MS=900000
SIGNUP_IP_MAX_REQUESTS=5
SIGNUP_IDENTITY_WINDOW_MS=3600000
SIGNUP_IDENTITY_MAX_REQUESTS=2
SIGNUP_DUPLICATE_WINDOW_MS=600000
SIGNUP_MIN_ELAPSED_MS=2500
SIGNUP_REVIEW_DUPLICATES=true
CUSTOMER_DASHBOARD_IP_WINDOW_MS=900000
CUSTOMER_DASHBOARD_IP_MAX_REQUESTS=30
CUSTOMER_DASHBOARD_LOOKUP_WINDOW_MS=3600000
CUSTOMER_DASHBOARD_LOOKUP_MAX_REQUESTS=8
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_LANGUAGE=en
STORE_CALL_TRANSCRIPTS=false
STORE_CALL_RECORDING_URLS=false
MAX_STORED_TRANSCRIPT_CHARS=4000
MAX_LEAD_SUMMARY_CHARS=1000
EXPOSE_CALL_TRANSCRIPTS_IN_ADMIN=false
EXPOSE_RECORDING_URLS_IN_ADMIN=false
CALL_TRANSCRIPT_RETENTION_DAYS=30
CALL_RECORDING_RETENTION_DAYS=30

# Vapi call-log sync. VAPI_BUSINESS_MAP maps Vapi assistant IDs, phone-number IDs,
# or phone numbers to local Business IDs.
VAPI_API_KEY=
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_EVAL_TARGET_ASSISTANT_ID=
VAPI_EVAL_TARGET_PHONE=2588
VAPI_EVAL_SUITE_FILE=config/vapi-agent-evals.json
VAPI_CALL_LIMIT=100
VAPI_DEFAULT_BUSINESS_ID=1
VAPI_REQUIRE_BUSINESS_MAPPING=true
VAPI_BUSINESS_MAP={"vapi-assistant-or-phone-number-id":1,"+12495033301":1}
VAPI_AUTO_SYNC_ENABLED=false
VAPI_AUTO_SYNC_INTERVAL_MS=900000
VAPI_SMS_ASSISTANT_ID=
VAPI_SMS_PHONE_NUMBER_ID=

# Trial usage enforcement. The Vapi phone-number gate reserves call time before
# answering, sends the owner a notice at 20 minutes, and blocks at 60 minutes.
TRIAL_USAGE_LIMIT_ENABLED=false
TRIAL_USAGE_WARNING_SECONDS=1200
TRIAL_USAGE_LIMIT_SECONDS=3600
TRIAL_USAGE_POLICY_INTERVAL_MS=300000
TRIAL_USAGE_MIN_CALL_SECONDS=15
TRIAL_USAGE_RESERVATION_GRACE_SECONDS=120
TRIAL_USAGE_GATE_WEBHOOK_URL=http://localhost:8787/api/webhooks/voice

# Tracked owner lead handoff: secure acknowledgement, retries, and backup escalation.
LEAD_ACK_BASE_URL=http://localhost:3000
LEAD_ACK_SECRET=
LEAD_ACK_TIMEOUT_MINUTES=2
LEAD_ACK_TOKEN_TTL_HOURS=72
LEAD_NOTIFICATION_MAX_RETRIES=2
LEAD_NOTIFICATION_RETRY_MINUTES=2
LEAD_HANDOFF_CHECK_INTERVAL_MS=60000

# Optional Jobber OAuth integration. Tokens are encrypted at rest.
FIELD_SERVICE_TOKEN_ENCRYPTION_KEY=
FIELD_SERVICE_OAUTH_STATE_SECRET=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://api.myaipa.ca/api/integrations/jobber/oauth/callback
JOBBER_GRAPHQL_VERSION=2025-04-16

# Vapi/Make agent drift diagnostic. MAKE_API_TOKEN is a Make API Token 2.0.
MAKE_API_BASE_URL=https://us2.make.com/api/v2
MAKE_API_TOKEN=
MAKE_SCENARIO_ID=3530157
MAKE_ASSISTANT_MODULE_ID=25

# Twilio per-call cost sync. Use the Twilio account connected to the Vapi phone numbers.
TWILIO_API_BASE_URL=https://api.twilio.com
FIXED_MONTHLY_COST_USD=0
FIXED_MONTHLY_COSTS_JSON=
MISSED_CALL_ALERT_ENABLED=false
DAILY_DIGEST_ENABLED=false

# Telegram screenshot delivery. Message the bot with /start before first use.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_URL=file:///C:/Users/Olive/OneDrive/Desktop/MyAIPA-Website/docs/index.html#/admin
GITHUB_SUPPORT_TOKEN=
GITHUB_SUPPORT_REPO=OllieinCanada/MyA.I.PA
GITHUB_SUPPORT_LABELS=
