NODE_ENV=production
PORT=8787
DATA_DIR=./data

# Public backend service URL, for example https://api.myaipa.ca
PUBLIC_APP_URL=

# Public owner-dashboard website used in appointment request text messages.
FRONTEND_APP_URL=https://www.myaipa.ca

# Comma-separated frontend origins allowed to call the API with cookies.
ALLOWED_ORIGINS=https://www.myaipa.ca,https://myaipa.ca

DATABASE_URL=

ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

OWNER_SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

MAKE_SIGNUP_WEBHOOK_URL=
MAKE_SIGNUP_WEBHOOK_API_KEY=
INTEGRATION_API_KEY=
VAPI_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=14
STRIPE_SUCCESS_URL=https://www.myaipa.ca/#/signup?payment=success
STRIPE_CANCEL_URL=https://www.myaipa.ca/#/signup?payment=cancelled
STRIPE_ALLOW_PROMOTION_CODES=false
TRIAL_HALFWAY_REMINDER_DAYS=7
TRIAL_REMINDER_CHECK_INTERVAL_MS=3600000
TRIAL_REMINDER_DISABLE=true

TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
SIGNUP_REQUIRE_MANUAL_APPROVAL=false
SIGNUP_REQUIRE_VERIFICATION=false
SIGNUP_IP_WINDOW_MS=900000
SIGNUP_IP_MAX_REQUESTS=5
SIGNUP_IDENTITY_WINDOW_MS=3600000
SIGNUP_IDENTITY_MAX_REQUESTS=2
SIGNUP_DUPLICATE_WINDOW_MS=600000
SIGNUP_MIN_ELAPSED_MS=2500
PUBLIC_ROUTE_WINDOW_MS=900000
BUSINESS_ENRICH_IP_MAX_REQUESTS=10
STRIPE_CHECKOUT_IP_MAX_REQUESTS=5
ADMIN_LOGIN_IP_MAX_REQUESTS=10
JSON_BODY_LIMIT=1mb
SIGNUP_REVIEW_DUPLICATES=true
CUSTOMER_DASHBOARD_IP_WINDOW_MS=900000
CUSTOMER_DASHBOARD_IP_MAX_REQUESTS=30
CUSTOMER_DASHBOARD_LOOKUP_WINDOW_MS=3600000
CUSTOMER_DASHBOARD_LOOKUP_MAX_REQUESTS=8
SIGNUP_VERIFICATION_TTL_MS=86400000
SIGNUP_VERIFICATION_BASE_URL=https://api.myaipa.ca
EMAIL_VERIFICATION_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=My AI PA <hello@myaipa.com>

# Optional owner/staff calendar connections. Customers confirm by SMS/email only.
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_OAUTH_STATE_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.myaipa.ca/api/calendar/oauth/google/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=https://api.myaipa.ca/api/calendar/oauth/microsoft/callback

OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_LANGUAGE=en

# Support inbox alerts and one-click repair handoffs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_SUPPORT_TOKEN=
GITHUB_SUPPORT_REPO=OllieinCanada/MyA.I.PA
GITHUB_SUPPORT_LABELS=

VAPI_API_KEY=
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_CALL_LIMIT=100
VAPI_DEFAULT_BUSINESS_ID=1
VAPI_REQUIRE_BUSINESS_MAPPING=true
VAPI_BUSINESS_MAP={"vapi-assistant-or-phone-number-id":1,"+12495033301":1}
VAPI_AUTO_SYNC_ENABLED=false
VAPI_AUTO_SYNC_INTERVAL_MS=900000
VAPI_SMS_ASSISTANT_ID=
VAPI_SMS_PHONE_NUMBER_ID=
LEAD_ACK_BASE_URL=https://api.myaipa.ca
LEAD_ACK_SECRET=
LEAD_ACK_TIMEOUT_MINUTES=2
LEAD_ACK_TOKEN_TTL_HOURS=72
LEAD_NOTIFICATION_MAX_RETRIES=2
LEAD_NOTIFICATION_RETRY_MINUTES=2
LEAD_HANDOFF_CHECK_INTERVAL_MS=60000

# Optional Jobber OAuth integration. Tokens are encrypted at rest.
FIELD_SERVICE_TOKEN_ENCRYPTION_KEY=
FIELD_SERVICE_OAUTH_STATE_SECRET=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://api.myaipa.ca/api/integrations/jobber/oauth/callback
JOBBER_GRAPHQL_VERSION=2025-04-16

STORE_CALL_TRANSCRIPTS=true
STORE_CALL_RECORDING_URLS=true
MAX_STORED_TRANSCRIPT_CHARS=4000
MAX_LEAD_SUMMARY_CHARS=1000
EXPOSE_CALL_TRANSCRIPTS_IN_ADMIN=true
EXPOSE_RECORDING_URLS_IN_ADMIN=true
CALL_TRANSCRIPT_RETENTION_DAYS=30
CALL_RECORDING_RETENTION_DAYS=30

TWILIO_API_BASE_URL=https://api.twilio.com
FIXED_MONTHLY_COST_USD=0
FIXED_MONTHLY_COSTS_JSON=

# Vapi/Make agent drift diagnostic. MAKE_API_TOKEN is a Make API Token 2.0.
MAKE_API_BASE_URL=https://us2.make.com/api/v2
MAKE_API_TOKEN=
MAKE_SCENARIO_ID=3530157
MAKE_ASSISTANT_MODULE_ID=25

MISSED_CALL_ALERT_ENABLED=false
DAILY_DIGEST_ENABLED=false
